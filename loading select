    TweenService:Create(GameLbl, outTi, {TextTransparency = 1}):Play()

    task.wait(0.3)
    WelcomeGui:Destroy()

    if not _selectedGame.ComingSoon and _selectedGame.Source and _selectedGame.Source ~= "" then
        task.spawn(function()
            local fn, err = loadstring(_selectedGame.Source)
            if fn then
                fn()
            else
                warn("[Axion] Error loading " .. _selectedGame.Name .. ": " .. tostring(err or "?"))
            end
        end)
    end
end)
