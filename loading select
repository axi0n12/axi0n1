local function closeDropdown()
    if not _dropOpen then return end
    _dropOpen = false
    Tw(DropArrow, {Rotation = 0}, 0.16):Play()
    Tw(DropBtnStroke, {Color = C.Border}, 0.16):Play()
    local t = Tw(DropList, {Size = UDim2.new(1, -36, 0, 0)}, 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    t:Play()
    t.Completed:Connect(function()
        if not _dropOpen then DropList.Visible = false end
    end)
end

local function openDropdown()
    if _dropOpen then return end
    _dropOpen = true
    DropList.Visible = true
    Tw(DropArrow, {Rotation = 180}, 0.18):Play()
    Tw(DropBtnStroke, {Color = C.Accent1}, 0.16):Play()
