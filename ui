                local ValLbl=Instance.new("TextLabel",Row)
                ValLbl.Size=UDim2.new(0.4,0,0,16); ValLbl.Position=UDim2.new(0.6,0,0,2)
                ValLbl.BackgroundTransparency=1; ValLbl.Text=tostring(val)
                ValLbl.TextColor3=C.Accent3; ValLbl.TextSize=10; ValLbl.Font=Enum.Font.GothamSemibold
                ValLbl.TextXAlignment=Enum.TextXAlignment.Right; ValLbl.ZIndex=14
                local Track=Instance.new("Frame",Row)
                Track.Size=UDim2.new(1,0,0,4); Track.Position=UDim2.new(0,0,0,22)
                Track.BackgroundColor3=C.Bg5; Track.BorderSizePixel=0; Track.ZIndex=14
                makeCorner(Track,3); makeStroke(Track,C.Muted2,1,0)
                local Fill=Instance.new("Frame",Track)
                Fill.Size=UDim2.new(math.clamp((val-min)/(max-min),0,1),0,1,0)
                Fill.BackgroundColor3=C.Accent; Fill.BorderSizePixel=0; Fill.ZIndex=15; makeCorner(Fill,3)

                local SliderBtn=Instance.new("TextButton",Track)
                SliderBtn.Size=UDim2.new(1,0,0,20); SliderBtn.Position=UDim2.new(0,0,0.5,-10)
                SliderBtn.BackgroundTransparency=1; SliderBtn.Text=""; SliderBtn.ZIndex=17

                local Slider={Value=val}
                local function Round(n)
                    if rnd==0 then return math.floor(n+0.5)
                    else return tonumber(string.format("%."..rnd.."f",n)) end
                end
                local function SetPx(px)
                    local pct=math.clamp(px/Track.AbsoluteSize.X,0,1)
                    local nv=Round(min+(max-min)*pct)
                    Slider.Value=nv; Window.Flags[flagKey]=nv
                    ValLbl.Text=tostring(nv)
                    Fill.Size=UDim2.new(pct,0,1,0); callback(nv)
                end
                local drag2=false
                SliderBtn.InputBegan:Connect(function(i)
                    if i.UserInputType==Enum.UserInputType.MouseButton1 then drag2=true; SetPx(Mouse.X-Track.AbsolutePosition.X) end
                end)
                UserInputService.InputEnded:Connect(function(i)
                    if i.UserInputType==Enum.UserInputType.MouseButton1 then drag2=false end
                end)
                UserInputService.InputChanged:Connect(function(i)
                    if drag2 and i.UserInputType==Enum.UserInputType.MouseMovement then SetPx(Mouse.X-Track.AbsolutePosition.X) end
                end)
                function Slider:Set(v)
                    v=math.clamp(Round(v),min,max); Slider.Value=v; Window.Flags[flagKey]=v
                    ValLbl.Text=tostring(v)
                    Fill.Size=UDim2.new((v-min)/(max-min),0,1,0); callback(v)
                end
                Window.Options[flagKey]=Slider
                AddItem(Row); return Slider
            end

            function Section:AddDropdown(cfg)
                cfg=cfg or {}
                local options=cfg.Values or {}
                local selected=cfg.Default or options[1] or ""
                local callback=cfg.Callback or function() end
                local flagKey=cfg.Flag or cfg.Name or "Dropdown"
                Window.Flags[flagKey]=selected

                local Row=Instance.new("Frame")
                Row.Size=UDim2.new(1,0,0,24); Row.BackgroundTransparency=1; Row.ZIndex=13

                local Lbl=Instance.new("TextLabel",Row)
                Lbl.Size=UDim2.new(0.45,0,1,0); Lbl.BackgroundTransparency=1
                Lbl.Text=cfg.Name or "Dropdown"; Lbl.TextColor3=C.Sub
                Lbl.TextSize=11; Lbl.Font=Enum.Font.Gotham
                Lbl.TextXAlignment=Enum.TextXAlignment.Left; Lbl.ZIndex=14

                local Sel=Instance.new("TextButton",Row)
                Sel.Size=UDim2.new(0.55,-2,1,-4); Sel.Position=UDim2.new(0.45,2,0.5,-10)
                Sel.BackgroundColor3=C.Bg4; Sel.Text=(tostring(selected) or "--").."  ▼"
                Sel.TextColor3=C.Text; Sel.TextSize=10; Sel.Font=Enum.Font.GothamSemibold
                Sel.AutoButtonColor=false; Sel.ZIndex=14
                makeCorner(Sel,4); makeStroke(Sel,C.Border,1,0)

                local Dropdown={Value=selected}

                local DFrame=Instance.new("Frame",ScreenGui)
                DFrame.Size=UDim2.new(0,140,0,#options*24+8)
                DFrame.BackgroundColor3=C.Bg3; DFrame.BorderSizePixel=0
                DFrame.Visible=false; DFrame.ZIndex=200
                makeCorner(DFrame,6); makeStroke(DFrame,C.Accent,1,0.4)

                local DL=Instance.new("UIListLayout",DFrame)
                DL.Padding=UDim.new(0,2); DL.SortOrder=Enum.SortOrder.LayoutOrder
                makePadding(DFrame,4,4,4,4)

                local opened=false
                local _dropHovered=false
                DFrame.MouseEnter:Connect(function() _dropHovered=true end)
                DFrame.MouseLeave:Connect(function() _dropHovered=false end)

                for _,opt in ipairs(options) do
                    local OBtn=Instance.new("TextButton",DFrame)
                    OBtn.Size=UDim2.new(1,0,0,22); OBtn.BackgroundColor3=C.Bg4
                    OBtn.BackgroundTransparency=opt==selected and 0.5 or 1
                    OBtn.Text=tostring(opt); OBtn.TextColor3=opt==selected and C.Accent3 or C.Sub
                    OBtn.TextSize=11; OBtn.Font=Enum.Font.Gotham
                    OBtn.AutoButtonColor=false; OBtn.ZIndex=201
                    makeCorner(OBtn,4)

                    OBtn.MouseButton1Click:Connect(function()
                        Dropdown.Value=opt; Window.Flags[flagKey]=opt
                        Sel.Text=tostring(opt).."  ▼"
                        opened=false; DFrame.Visible=false; _dropHovered=false
                        callback(opt)
                    end)
                end

                Sel.MouseButton1Click:Connect(function()
                    opened=not opened; DFrame.Visible=opened
                    if opened then
                        local abs=Sel.AbsolutePosition
                        DFrame.Position=UDim2.fromOffset(abs.X,abs.Y+Sel.AbsoluteSize.Y+3)
                    end
                end)

                function Dropdown:Set(v)
                    Dropdown.Value=v; Window.Flags[flagKey]=v
                    Sel.Text=tostring(v).."  ▼"; callback(v)
                end

                Window.Options[flagKey]=Dropdown
                AddItem(Row); return Dropdown
            end

            function Section:AddMouseKeybind(cfg)
                cfg=cfg or {}
                local cur
                if type(cfg.Default)=="table" and cfg.Default.type then
                    cur=cfg.Default
                else
                    cur={type="key", value=cfg.Default or Enum.KeyCode.E}
                end
                local listen=false
                local callback=cfg.Callback or function() end

                local function bindLabel(b)
                    if not b then return "None" end
                    if b.type=="mouse" then return MOUSE_NAMES[b.value] or "Mouse?"
                    else return b.value and b.value.Name or "?" end
                end

                local Row=Instance.new("Frame")
                Row.Size=UDim2.new(1,0,0,24); Row.BackgroundTransparency=1; Row.ZIndex=13
                local Lbl=Instance.new("TextLabel",Row)
                Lbl.Size=UDim2.new(0.6,0,1,0); Lbl.BackgroundTransparency=1
                Lbl.Text=cfg.Name or "Keybind"; Lbl.TextColor3=C.Sub
                Lbl.TextSize=11; Lbl.Font=Enum.Font.Gotham
                Lbl.TextXAlignment=Enum.TextXAlignment.Left; Lbl.ZIndex=14
                local KB=Instance.new("TextButton",Row)
                KB.Size=UDim2.new(0.4,-2,1,-4); KB.Position=UDim2.new(0.6,2,0.5,-10)
                KB.BackgroundColor3=C.Bg4; KB.Text=bindLabel(cur)
                KB.TextColor3=C.Accent3; KB.TextSize=10; KB.Font=Enum.Font.GothamBold
                KB.AutoButtonColor=false; KB.ZIndex=14
                makeCorner(KB,4); makeStroke(KB,C.Border,1,0)

                local Bind={Value=cur}

                KB.InputBegan:Connect(function(inp)
                    if inp.UserInputType~=Enum.UserInputType.MouseButton1 then return end
                    if listen then return end
                    task.spawn(function()
                        RunService.Heartbeat:Wait()
                        listen=true; KB.Text="..."; KB.TextColor3=C.White
                    end)
                end)

                UserInputService.InputBegan:Connect(function(inp, processed)
                    if not listen or processed then return end
                    local isMouse=false
                    for _,mt in ipairs(MOUSE_TYPES) do
                        if inp.UserInputType==mt then
                            isMouse=true; cur={type="mouse",value=inp.UserInputType}; break
                        end
                    end
                    if not isMouse then
                        if inp.UserInputType==Enum.UserInputType.Keyboard then
                            if inp.KeyCode==Enum.KeyCode.Escape then
                                listen=false; KB.Text=bindLabel(cur); KB.TextColor3=C.Accent3; return
                            end
                            cur={type="key",value=inp.KeyCode}
                        else return end
                    end
                    listen=false; Bind.Value=cur
                    KB.Text=bindLabel(cur); KB.TextColor3=C.Accent3
                    callback(cur)
                end)

                function Bind:Set(b)
                    if type(b)=="table" and b.type then cur=b else cur={type="key",value=b} end
                    Bind.Value=cur; KB.Text=bindLabel(cur); KB.TextColor3=C.Accent3; callback(cur)
                end

                AddItem(Row); return Bind
            end

            function Section:AddKeybind(cfg)
                return Section:AddMouseKeybind(cfg)
            end

