local _notifSlots = {}
local function CreateNotification(title, text, duration, ntype)
    if typeof(title) == "table" then title, text, duration, ntype = text, duration, ntype, nil end
    title = tostring(title or "Notification")
    text  = tostring(text or "")
    PlaySound(SOUND_NOTIF)
    ntype = ntype or "info"
    local dotColor = (ntype == "error" and C.Red) or (ntype == "success" and C.Green) or C.Accent

    local G = Instance.new("ScreenGui")
    G.Name = "KxNotif_"..tostring(tick())
    G.IgnoreGuiInset = true; G.ZIndexBehavior = Enum.ZIndexBehavior.Global
    G.ResetOnSpawn = false
    protect(G)

    local H = 32; local MARGIN = 12
    local slot = 0
    while _notifSlots[slot] do slot += 1 end
    _notifSlots[slot] = true

    local F = Instance.new("Frame", G)
    F.Size             = UDim2.new(0, 280, 0, H); F.AutomaticSize = Enum.AutomaticSize.Y
    F.Position         = UDim2.new(1, 30, 1, -(MARGIN+(H+MARGIN)*slot))
    F.AnchorPoint      = Vector2.new(1,1)
    F.BackgroundColor3 = C.CardBg; F.BorderSizePixel = 0
    F.ClipsDescendants = true
    mkCorner(F, 4); mkStroke(F, C.CardBorder, 1, 0)

    local List = Instance.new("UIListLayout", F)
    List.FillDirection = Enum.FillDirection.Horizontal
    List.VerticalAlignment = Enum.VerticalAlignment.Top
    List.Padding = UDim.new(0, 8)
    mkPad(F, 8, 8, 10, 10)

    local Dot = Instance.new("Frame", F)
    Dot.Size = UDim2.new(0, 6, 0, 6); Dot.Position = UDim2.new(0, 0, 0, 4)
    Dot.BackgroundColor3 = dotColor; Dot.BorderSizePixel = 0; mkCorner(Dot, 3)

    local TextCol = Instance.new("Frame", F)
    TextCol.Size = UDim2.new(1, -20, 0, 0); TextCol.AutomaticSize = Enum.AutomaticSize.Y
    TextCol.BackgroundTransparency = 1

    local TextList = Instance.new("UIListLayout", TextCol)
    TextList.Padding = UDim.new(0, 2)

    local T = Instance.new("TextLabel", TextCol)
    T.Size = UDim2.new(1, 0, 0, 0); T.AutomaticSize = Enum.AutomaticSize.Y
    T.BackgroundTransparency = 1; T.Text = title
    T.TextColor3 = C.Bright; T.TextSize = 11; T.Font = Enum.Font.GothamBold
    T.TextXAlignment = Enum.TextXAlignment.Left; T.TextWrapped = true

    local D = Instance.new("TextLabel", TextCol)
    D.Size = UDim2.new(1, 0, 0, 0); D.AutomaticSize = Enum.AutomaticSize.Y
    D.BackgroundTransparency = 1; D.Text = text
    D.TextColor3 = C.Text; D.TextSize = 10; D.Font = Enum.Font.Gotham
    D.TextXAlignment = Enum.TextXAlignment.Left; D.TextWrapped = true

    local dur = duration or 3
    Tween(F, {Position = UDim2.new(1, -MARGIN, 1, -(MARGIN+(H+MARGIN)*slot))}, 0.25, Enum.EasingStyle.Back):Play()
    task.delay(dur, function()
        _notifSlots[slot] = nil
        Tween(F, {Position = UDim2.new(1, 30, 1, -(MARGIN+(H+MARGIN)*slot))}, 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In):Play()
        task.wait(0.22); G:Destroy()
    end)
end

KraviX.Notify = function(self, title, text, duration)
    if typeof(self) == "string" then title, text, duration = self, title, text end
    CreateNotification(title, text, duration, "info")
end

