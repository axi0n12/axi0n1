local function PlaySound(id)
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = id; s.Volume = 0.5; s.Parent = SoundService; s:Play()
        game:GetService("Debris"):AddItem(s, 3)
    end)
end

local function Tween(obj, props, t, style, dir)
    return TweenService:Create(obj,
        TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
        props)
end

local function protect(gui)
    for _, v in ipairs(CoreGui:GetChildren()) do
        if v.Name == gui.Name then pcall(function() v:Destroy() end) end
    end
    if gethui then
        for _, v in ipairs(gethui():GetChildren()) do
            if v.Name == gui.Name then pcall(function() v:Destroy() end) end
        end
    end
    if syn and syn.protect_gui then syn.protect_gui(gui); gui.Parent = CoreGui
    elseif gethui then gui.Parent = gethui()
    else gui.Parent = CoreGui end
end

