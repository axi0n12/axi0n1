    RightScroll.Size = UDim2.new(0.49, -4, 1, 0); RightScroll.Position = UDim2.new(0.51, 4, 0, 0)
    RightScroll.BackgroundTransparency = 1; RightScroll.BorderSizePixel = 0
    RightScroll.ScrollBarThickness = 2; RightScroll.ScrollBarImageColor3 = C.CardBorder
    RightScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y; RightScroll.CanvasSize = UDim2.new(0,0,0,0)

    local RightLayout = Instance.new("UIListLayout", RightScroll)
    RightLayout.Padding = UDim.new(0, 8)

    local activeTab = nil

    function Window:CreateTab(tabName, icon)
        local Tab = { SubTabs = {}, ActiveSub = nil }
        table.insert(Window.Tabs, Tab)

        local TabBtn = Instance.new("TextButton", TabBar)
        TabBtn.Size = UDim2.new(0, 0, 0, 24); TabBtn.AutomaticSize = Enum.AutomaticSize.X
        TabBtn.BackgroundColor3 = C.TabPill; TabBtn.BackgroundTransparency = 1
        TabBtn.Text = tabName; TabBtn.TextColor3 = C.Text
        TabBtn.TextSize = 10; TabBtn.Font = Enum.Font.GothamMedium
        TabBtn.AutoButtonColor = false; TabBtn.ZIndex = 14
        mkCorner(TabBtn, 4); mkPad(TabBtn, 0, 0, 8, 8)

        local tabPillStroke = mkStroke(TabBtn, C.TabPillLine, 1, 1)

        local function selectTab()
            for _, t in ipairs(Window.Tabs) do
                if t._Btn then
                    Tween(t._Btn, {BackgroundTransparency = 1, TextColor3 = C.Text}, 0.15):Play()
                    Tween(t._Stroke, {Transparency = 1}, 0.15):Play()
                end
                for _, st in ipairs(t.SubTabs) do
                    for _, sec in ipairs(st.Sections) do
                        sec.Frame.Visible = false
                    end
                end
            end
            activeTab = Tab
            Tween(TabBtn, {BackgroundTransparency = 0, TextColor3 = C.Bright}, 0.15):Play()
            Tween(tabPillStroke, {Transparency = 0}, 0.15):Play()

            for _, st in ipairs(Tab.SubTabs) do
                for _, sec in ipairs(st.Sections) do
                    sec.Frame.Visible = true
                end
            end
        end

        Tab._Btn = TabBtn
        Tab._Stroke = tabPillStroke

        TabBtn.MouseButton1Click:Connect(selectTab)
        if #Window.Tabs == 1 then selectTab() end

        function Tab:AddSection(secTitle, colSide)
            if #Tab.SubTabs == 0 then
                Tab:AddSubTab("_default")
            end
            local lastSub = Tab.SubTabs[#Tab.SubTabs]
            return lastSub:AddSection(secTitle, colSide)
        end

        function Tab:AddSubTab(subName)
            local SubTab = { Sections = {} }
            table.insert(Tab.SubTabs, SubTab)

            function SubTab:AddSection(secTitle, colSide)
                local Section = { Controls = {} }
                table.insert(SubTab.Sections, Section)

                colSide = (colSide and tostring(colSide):lower() == "right") and "Right" or "Left"
                local targetParent = (colSide == "Right") and RightScroll or LeftScroll

                local Card = Instance.new("Frame", targetParent)
                Card.Name = "MatchaCard_" .. secTitle
                Card.Size = UDim2.new(1, -6, 0, 0); Card.AutomaticSize = Enum.AutomaticSize.Y
                Card.BackgroundColor3 = C.CardBg; Card.BorderSizePixel = 0; Card.ZIndex = 12
                Card.Visible = (activeTab == Tab)
                mkCorner(Card, 4); mkStroke(Card, C.CardBorder, 1, 0)

                local CardPad = mkPad(Card, 8, 8, 10, 10)

                local CardList = Instance.new("UIListLayout", Card)
                CardList.SortOrder = Enum.SortOrder.LayoutOrder
                CardList.Padding = UDim.new(0, 6)

                -- Top Sub-Tab Pill Bar inside Card if title is empty or has subtabs
                local HeaderFrame = Instance.new("Frame", Card)
                HeaderFrame.Size = UDim2.new(1, 0, 0, 18)
                HeaderFrame.BackgroundTransparency = 1; HeaderFrame.LayoutOrder = 0

                local HeaderTitle = Instance.new("TextLabel", HeaderFrame)
                HeaderTitle.Size = UDim2.new(1, 0, 1, 0)
                HeaderTitle.BackgroundTransparency = 1
                HeaderTitle.Text = secTitle; HeaderTitle.TextColor3 = C.Bright
                HeaderTitle.TextSize = 10; HeaderTitle.Font = Enum.Font.GothamBold
                HeaderTitle.TextXAlignment = Enum.TextXAlignment.Left

                Section.Frame = Card
                Section.Content = Card

                local function addItem(obj)
                    obj.Parent = Card
                    obj.ZIndex = 13
                end

                -- ===== CONTROLES MATCHA =====
                function Section:AddToggle(cfg)
                    cfg = cfg or {}
                    local name = cfg.Name or "Toggle"
                    local val = cfg.Default or false
                    local cb = cfg.Callback or function() end
                    local flagKey = cfg.Flag or name

                    Window.Flags[flagKey] = val

                    local Row = Instance.new("Frame")
                    Row.Size = UDim2.new(1, 0, 0, 20); Row.BackgroundTransparency = 1

                    local Box = Instance.new("Frame", Row)
                    Box.Size = UDim2.new(0, 13, 0, 13); Box.Position = UDim2.new(0, 0, 0.5, -6)
                    Box.BackgroundColor3 = val and C.Accent or C.Control
                    mkCorner(Box, 3)
                    local boxStroke = mkStroke(Box, val and C.AccentHi or C.ControlLine, 1, 0)

                    local Check = Instance.new("Frame", Box)
                    Check.Size = UDim2.new(0, 5, 0, 5); Check.AnchorPoint = Vector2.new(0.5, 0.5)
                    Check.Position = UDim2.new(0.5, 0, 0.5, 0)
                    Check.BackgroundColor3 = C.Bright
                    Check.Visible = val; mkCorner(Check, 2)

                    local Lbl = Instance.new("TextLabel", Row)
                    Lbl.Size = UDim2.new(1, -24, 1, 0); Lbl.Position = UDim2.new(0, 20, 0, 0)
                    Lbl.BackgroundTransparency = 1; Lbl.Text = name
                    Lbl.TextColor3 = val and C.Bright or C.Text; Lbl.TextSize = 10
                    Lbl.Font = Enum.Font.GothamMedium; Lbl.TextXAlignment = Enum.TextXAlignment.Left

                    local Click = Instance.new("TextButton", Row)
                    Click.Size = UDim2.new(1, 0, 1, 0); Click.BackgroundTransparency = 1; Click.Text = ""

                    local function setToggle(v)
                        val = v; Window.Flags[flagKey] = val
                        Check.Visible = val
                        Tween(Box, {BackgroundColor3 = val and C.Accent or C.Control}, 0.12):Play()
                        Tween(boxStroke, {Color = val and C.AccentHi or C.ControlLine}, 0.12):Play()
                        Tween(Lbl, {TextColor3 = val and C.Bright or C.Text}, 0.12):Play()
                        pcall(cb, val)
                    end

                    Click.MouseButton1Click:Connect(function() setToggle(not val) end)
                    addItem(Row)

                    local Handle = { Set = setToggle, Value = val }
                    Window.Options[flagKey] = Handle
                    return Handle
                end

                function Section:AddSlider(cfg)
                    cfg = cfg or {}
                    local name = cfg.Name or "Slider"
                    local min = cfg.Min or 0
                    local max = cfg.Max or 100
                    local val = cfg.Default or min
                    local round = cfg.Rounding or 0
                    local cb = cfg.Callback or function() end
                    local flagKey = cfg.Flag or name

                    Window.Flags[flagKey] = val

                    local Cont = Instance.new("Frame")
                    Cont.Size = UDim2.new(1, 0, 0, 30); Cont.BackgroundTransparency = 1

                    local Lbl = Instance.new("TextLabel", Cont)
                    Lbl.Size = UDim2.new(0.7, 0, 0, 14); Lbl.BackgroundTransparency = 1
                    Lbl.Text = name; Lbl.TextColor3 = C.Text; Lbl.TextSize = 10
                    Lbl.Font = Enum.Font.GothamMedium; Lbl.TextXAlignment = Enum.TextXAlignment.Left

                    local ValLbl = Instance.new("TextLabel", Cont)
                    ValLbl.Size = UDim2.new(0.3, 0, 0, 14); ValLbl.Position = UDim2.new(0.7, 0, 0, 0)
                    ValLbl.BackgroundTransparency = 1; ValLbl.Text = tostring(val)
                    ValLbl.TextColor3 = C.Value; ValLbl.TextSize = 10
                    ValLbl.Font = Enum.Font.Gotham; ValLbl.TextXAlignment = Enum.TextXAlignment.Right

                    local Track = Instance.new("Frame", Cont)
                    Track.Size = UDim2.new(1, 0, 0, 4); Track.Position = UDim2.new(0, 0, 0, 18)
                    Track.BackgroundColor3 = C.Track; mkCorner(Track, 2)
                    mkStroke(Track, C.TrackLine, 1, 0)

                    local Fill = Instance.new("Frame", Track)
                    local pct = math.clamp((val - min)/(max - min), 0, 1)
                    Fill.Size = UDim2.new(pct, 0, 1, 0); Fill.BackgroundColor3 = C.Accent
                    mkCorner(Fill, 2)

                    local sliding = false
                    local function update(input)
                        local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X)/Track.AbsoluteSize.X, 0, 1)
                        local rawVal = min + (max - min)*pos
                        local factor = 10^round
                        val = math.floor(rawVal * factor + 0.5)/factor
                        Window.Flags[flagKey] = val
                        Fill.Size = UDim2.new(pos, 0, 1, 0)
                        ValLbl.Text = tostring(val)
                        pcall(cb, val)
                    end

                    Track.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            sliding = true; update(input)
                        end
                    end)
                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
                    end)
                    UserInputService.InputChanged:Connect(function(input)
                        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end
                    end)

                    addItem(Cont)
                    local Handle = { Set = function(_, v) val = v; update({Position=Vector3.new(Track.AbsolutePosition.X + Track.AbsoluteSize.X*((v-min)/(max-min)),0,0)}) end }
                    Window.Options[flagKey] = Handle
                    return Handle
                end

                function Section:AddDropdown(cfg)
                    cfg = cfg or {}
                    local name = cfg.Name or "Dropdown"
                    local vals = cfg.Values or {}
                    local val = cfg.Default or vals[1] or ""
                    local cb = cfg.Callback or function() end
                    local flagKey = cfg.Flag or name

                    Window.Flags[flagKey] = val

                    local Cont = Instance.new("Frame")
                    Cont.Size = UDim2.new(1, 0, 0, 36); Cont.BackgroundTransparency = 1

                    local Lbl = Instance.new("TextLabel", Cont)
                    Lbl.Size = UDim2.new(1, 0, 0, 14); Lbl.BackgroundTransparency = 1
                    Lbl.Text = name; Lbl.TextColor3 = C.Text; Lbl.TextSize = 10
                    Lbl.Font = Enum.Font.GothamMedium; Lbl.TextXAlignment = Enum.TextXAlignment.Left

                    local DropBtn = Instance.new("TextButton", Cont)
                    DropBtn.Size = UDim2.new(1, 0, 0, 18); DropBtn.Position = UDim2.new(0, 0, 0, 16)
                    DropBtn.BackgroundColor3 = C.Control; DropBtn.Text = "  " .. tostring(val)
                    DropBtn.TextColor3 = C.Bright; DropBtn.TextSize = 10
                    DropBtn.Font = Enum.Font.Gotham; DropBtn.TextXAlignment = Enum.TextXAlignment.Left
                    DropBtn.AutoButtonColor = false; mkCorner(DropBtn, 3)
                    mkStroke(DropBtn, C.ControlLine, 1, 0)

                    local Arrow = Instance.new("TextLabel", DropBtn)
                    Arrow.Size = UDim2.new(0, 18, 1, 0); Arrow.Position = UDim2.new(1, -18, 0, 0)
                    Arrow.BackgroundTransparency = 1; Arrow.Text = "▼"; Arrow.TextColor3 = C.Arrow
                    Arrow.TextSize = 8; Arrow.Font = Enum.Font.GothamBold

                    local open = false
                    local ListFrame = Instance.new("Frame", ScreenGui)
                    ListFrame.Size = UDim2.new(0, 150, 0, 0); ListFrame.BackgroundColor3 = C.Control
                    ListFrame.Visible = false; ListFrame.ZIndex = 300; mkCorner(ListFrame, 3)
                    mkStroke(ListFrame, C.ControlLineH, 1, 0)

                    local ListLayout = Instance.new("UIListLayout", ListFrame)
                    ListLayout.Padding = UDim.new(0, 2)
                    mkPad(ListFrame, 4, 4, 4, 4)

                    local function toggleDrop()
                        open = not open
                        if open then
                            ListFrame.Position = UDim2.new(0, DropBtn.AbsolutePosition.X, 0, DropBtn.AbsolutePosition.Y + 22)
                            ListFrame.Size = UDim2.new(0, DropBtn.AbsoluteSize.X, 0, math.min(#vals*20 + 8, 120))
                            ListFrame.Visible = true
                        else
                            ListFrame.Visible = false
                        end
                    end

                    for _, item in ipairs(vals) do
                        local ItemBtn = Instance.new("TextButton", ListFrame)
                        ItemBtn.Size = UDim2.new(1, 0, 0, 18); ItemBtn.BackgroundColor3 = C.Control
                        ItemBtn.BackgroundTransparency = 1; ItemBtn.Text = " " .. tostring(item)
                        ItemBtn.TextColor3 = (item == val) and C.Accent or C.Text
                        ItemBtn.TextSize = 10; ItemBtn.Font = Enum.Font.Gotham
                        ItemBtn.TextXAlignment = Enum.TextXAlignment.Left; ItemBtn.ZIndex = 301

                        ItemBtn.MouseButton1Click:Connect(function()
                            val = item; Window.Flags[flagKey] = val
                            DropBtn.Text = "  " .. tostring(val)
                            toggleDrop()
                            pcall(cb, val)
                        end)
                    end

                    DropBtn.MouseButton1Click:Connect(toggleDrop)
                    addItem(Cont)

                    local Handle = { Set = function(_, v) val = v; DropBtn.Text = "  " .. tostring(val) end }
                    Window.Options[flagKey] = Handle
                    return Handle
                end

                function Section:AddMouseKeybind(cfg)
                    cfg = cfg or {}
                    local name = cfg.Name or "Keybind"
                    local defaultBind = cfg.Default or {type="key", value=Enum.KeyCode.None}
                    local cb = cfg.Callback or function() end

                    local bindVal = defaultBind.value
                    local bindType = defaultBind.type or "key"

                    local Cont = Instance.new("Frame")
                    Cont.Size = UDim2.new(1, 0, 0, 20); Cont.BackgroundTransparency = 1

                    local Lbl = Instance.new("TextLabel", Cont)
                    Lbl.Size = UDim2.new(0.6, 0, 1, 0); Lbl.BackgroundTransparency = 1
                    Lbl.Text = name; Lbl.TextColor3 = C.Text; Lbl.TextSize = 10
                    Lbl.Font = Enum.Font.GothamMedium; Lbl.TextXAlignment = Enum.TextXAlignment.Left

                    local KeyBtn = Instance.new("TextButton", Cont)
                    KeyBtn.Size = UDim2.new(0.38, 0, 0, 16); KeyBtn.Position = UDim2.new(0.62, 0, 0.5, -8)
                    KeyBtn.BackgroundColor3 = C.Control; KeyBtn.Text = "[" .. (typeof(bindVal)=="EnumItem" and bindVal.Name or tostring(bindVal)) .. "]"
                    KeyBtn.TextColor3 = C.Bright; KeyBtn.TextSize = 9
                    KeyBtn.Font = Enum.Font.Code; KeyBtn.AutoButtonColor = false; mkCorner(KeyBtn, 3)
                    mkStroke(KeyBtn, C.ControlLine, 1, 0)

                    local Handle = { Value = {type=bindType, value=bindVal} }

                    local listening = false
                    KeyBtn.MouseButton1Click:Connect(function()
                        listening = true; KeyBtn.Text = "[...]"
                        local conn; conn = UserInputService.InputBegan:Connect(function(input)
                            if input.UserInputType == Enum.UserInputType.Keyboard then
                                bindVal = input.KeyCode; bindType = "key"
                            elseif MOUSE_NAMES[input.UserInputType] then
                                bindVal = input.UserInputType; bindType = "mouse"
                            end
                            if bindVal then
                                Handle.Value = {type=bindType, value=bindVal}
                                KeyBtn.Text = "[" .. (typeof(bindVal)=="EnumItem" and bindVal.Name or tostring(bindVal)) .. "]"
                                listening = false; conn:Disconnect()
                                pcall(cb, Handle.Value)
                            end
                        end)
                    end)

                    addItem(Cont)
                    return Handle
                end

                function Section:AddColorPicker(cfg)
                    cfg = cfg or {}
                    local name = cfg.Name or "Color Picker"
                    local color = cfg.Default or Color3.fromRGB(255, 255, 255)
                    local cb = cfg.Callback or function() end

                    local Cont = Instance.new("Frame")
                    Cont.Size = UDim2.new(1, 0, 0, 20); Cont.BackgroundTransparency = 1

                    local Lbl = Instance.new("TextLabel", Cont)
                    Lbl.Size = UDim2.new(0.7, 0, 1, 0); Lbl.BackgroundTransparency = 1
                    Lbl.Text = name; Lbl.TextColor3 = C.Text; Lbl.TextSize = 10
                    Lbl.Font = Enum.Font.GothamMedium; Lbl.TextXAlignment = Enum.TextXAlignment.Left

                    local ColorBox = Instance.new("Frame", Cont)
                    ColorBox.Size = UDim2.new(0, 24, 0, 12); ColorBox.Position = UDim2.new(1, -24, 0.5, -6)
                    ColorBox.BackgroundColor3 = color; mkCorner(ColorBox, 3)
                    mkStroke(ColorBox, C.ControlLine, 1, 0)

                    addItem(Cont)
                    return { Set = function(_, c) color = c; ColorBox.BackgroundColor3 = c end }
                end

                function Section:AddButton(cfg)
                    cfg = cfg or {}
                    local name = cfg.Name or "Button"
                    local cb = cfg.Callback or function() end

                    local Btn = Instance.new("TextButton")
                    Btn.Size = UDim2.new(1, 0, 0, 22); Btn.BackgroundColor3 = C.Control
                    Btn.Text = name; Btn.TextColor3 = C.Bright; Btn.TextSize = 10
                    Btn.Font = Enum.Font.GothamMedium; Btn.AutoButtonColor = false; mkCorner(Btn, 3)
                    local btnStroke = mkStroke(Btn, C.ControlLine, 1, 0)

                    Btn.MouseEnter:Connect(function()
                        Tween(Btn, {BackgroundColor3 = C.ControlHov}, 0.12):Play()
                        Tween(btnStroke, {Color = C.Accent}, 0.12):Play()
                    end)
                    Btn.MouseLeave:Connect(function()
                        Tween(Btn, {BackgroundColor3 = C.Control}, 0.12):Play()
                        Tween(btnStroke, {Color = C.ControlLine}, 0.12):Play()
                    end)
                    Btn.MouseButton1Click:Connect(function() pcall(cb) end)

                    addItem(Btn)
                    return Btn
                end

                function Section:AddLabel(cfg)
                    cfg = cfg or {}
                    local text = cfg.Text or ""
                    local Lbl = Instance.new("TextLabel")
                    Lbl.Size = UDim2.new(1, 0, 0, 16); Lbl.BackgroundTransparency = 1
                    Lbl.Text = text; Lbl.TextColor3 = C.Dim; Lbl.TextSize = 10
                    Lbl.Font = Enum.Font.Gotham; Lbl.TextXAlignment = Enum.TextXAlignment.Left
                    Lbl.TextWrapped = true

                    addItem(Lbl)
                    return { SetText = function(_, t) Lbl.Text = t end }
                end

                function Section:AddTextbox(cfg)
                    cfg = cfg or {}
                    local name = cfg.Name or "Textbox"
                    local placeholder = cfg.Placeholder or "Digite aqui..."
                    local cb = cfg.Callback or function() end

                    local Cont = Instance.new("Frame")
                    Cont.Size = UDim2.new(1, 0, 0, 36); Cont.BackgroundTransparency = 1

                    local Lbl = Instance.new("TextLabel", Cont)
                    Lbl.Size = UDim2.new(1, 0, 0, 14); Lbl.BackgroundTransparency = 1
                    Lbl.Text = name; Lbl.TextColor3 = C.Text; Lbl.TextSize = 10
                    Lbl.Font = Enum.Font.GothamMedium; Lbl.TextXAlignment = Enum.TextXAlignment.Left

                    local Box = Instance.new("TextBox", Cont)
                    Box.Size = UDim2.new(1, 0, 0, 18); Box.Position = UDim2.new(0, 0, 0, 16)
                    Box.BackgroundColor3 = C.Control; Box.Text = ""; Box.PlaceholderText = placeholder
                    Box.TextColor3 = C.Bright; Box.PlaceholderColor3 = C.Dim; Box.TextSize = 10
                    Box.Font = Enum.Font.Gotham; Box.TextXAlignment = Enum.TextXAlignment.Left
                    mkCorner(Box, 3); mkStroke(Box, C.ControlLine, 1, 0)
                    mkPad(Box, 0, 0, 4, 4)

                    Box.FocusLost:Connect(function(enter)
                        if enter then pcall(cb, Box.Text) end
                    end)

                    addItem(Cont)
                    return Box
                end

                function Section:AddSeparator()
                    local Sep = Instance.new("Frame")
                    Sep.Size = UDim2.new(1, 0, 0, 1); Sep.BackgroundColor3 = C.Sep
                    Sep.BorderSizePixel = 0
                    addItem(Sep)
                end

                return Section
            end
            return SubTab
        end

        return Tab
    end

    -- ===== REAL 3D VIEWPORT ESP PREVIEW SYSTEM =====
    local ViewportCamera = Instance.new("Camera")
    ViewportCamera.FieldOfView = 60

    local ViewmodelFolder = Instance.new("Folder")
    ViewmodelFolder.Name = "ESPPreviewModel"

    function Window:BindESPPreview(espTable)
        Window._BoundESPSettings = espTable
    end
    function Window:UpdateESPPreview(patch) end

    Window.ESPPreview = {
        Bind = function(_, tbl) Window:BindESPPreview(tbl) end,
        Update = function(_, patch) Window:UpdateESPPreview(patch) end
    }

    Window.NotifyInfo = function(self, title, text, duration)
        if typeof(self) == "string" then title, text, duration = self, title, text end
        CreateNotification(title, text, duration, "info")
    end
    Window.Notify = Window.NotifyInfo

    Window.ShowWindow = function() Main.Visible = true end
    Window.HideWindow = function() Main.Visible = false end
    Window.ToggleWindow = function()
        Main.Visible = not Main.Visible
    end
    CloseBtn.MouseButton1Click:Connect(Window.ToggleWindow)

    CreateNotification(config.Name, "Interface Matcha carregada com sucesso!", 3, "success")
    return Window
end

