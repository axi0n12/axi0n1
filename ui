            function Section:AddTextbox(cfg)
                cfg=cfg or {}
                local callback=cfg.Callback or function() end
                local Row=Instance.new("Frame")
                Row.Size=UDim2.new(1,0,0,24); Row.BackgroundTransparency=1; Row.ZIndex=13
                local Lbl=Instance.new("TextLabel",Row)
                Lbl.Size=UDim2.new(0.4,0,1,0); Lbl.BackgroundTransparency=1
                Lbl.Text=cfg.Name or "Input"; Lbl.TextColor3=C.Sub
                Lbl.TextSize=11; Lbl.Font=Enum.Font.Gotham
                Lbl.TextXAlignment=Enum.TextXAlignment.Left; Lbl.ZIndex=14
                local Box=Instance.new("TextBox",Row)
                Box.Size=UDim2.new(0.6,-2,1,-4); Box.Position=UDim2.new(0.4,2,0.5,-10)
                Box.BackgroundColor3=C.Bg4
                Box.PlaceholderText=cfg.Placeholder or "Type here..."
                Box.PlaceholderColor3=C.Muted; Box.Text=cfg.Default or ""
                Box.TextColor3=C.Text; Box.TextSize=10; Box.Font=Enum.Font.Gotham
                Box.ClearTextOnFocus=false; Box.ZIndex=14
                makeCorner(Box,4); makeStroke(Box,C.Border,1,0); makePadding(Box,0,0,6,6)
                Box.FocusLost:Connect(function(enter)
                    if enter then callback(Box.Text) end
                end)
